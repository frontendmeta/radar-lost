# Lost Sale Radar — Next.js app environment (Vercel → Settings → Environment Variables, and .env.local for dev)
# Copy to .env.local for local dev. Never commit real values: .env* files are gitignored except this one.
# Provider API keys (OpenAI / Anthropic / Gemini) are NOT set here — paste them in the app at /settings/keys
# (stored encrypted in Supabase Vault). The edge function's own env lives in supabase/functions/.env.example.

# --- Supabase -------------------------------------------------------------
# Hosted: https://<project-ref>.supabase.co   ·   Local: http://127.0.0.1:55321
SUPABASE_URL=https://pdzhvntakoalbxphdvmg.supabase.co
# Server-only. Dashboard → Project Settings → API keys → service_role (or `supabase status` locally). Never NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Browser sign-in only (Google via Supabase Auth). Same project URL; the anon / publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://pdzhvntakoalbxphdvmg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# --- Processor (Supabase Edge Function process-run) ------------------------
PROCESSOR_URL=https://pdzhvntakoalbxphdvmg.supabase.co/functions/v1/process-run
# Long random string; must equal PROCESSOR_SECRET in the function's secrets and the Vault secret `processor_secret`.
# Generate with: openssl rand -hex 32
PROCESSOR_SECRET=<same-secret-as-the-edge-function>

# --- Auth -----------------------------------------------------------------
# Google OAuth client ID / secret are NOT app env vars. Supabase runs the Google exchange, so they go in:
#   Hosted: Supabase Dashboard → Authentication → Sign In / Providers → Google (Client ID + Client Secret).
#   Local:  a root .env read by the Supabase CLI (gitignored), plus enabled = true under
#           [auth.external.google] in supabase/config.toml, then restart `supabase start`:
#             SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=<google-client-id>
#             SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=<google-client-secret>
# Google Cloud OAuth client → Authorized redirect URIs (Supabase callbacks, not the app):
#   https://<project-ref>.supabase.co/auth/v1/callback   and   http://127.0.0.1:55321/auth/v1/callback
# Supabase → Authentication → URL Configuration: Site URL = https://<your-app>.vercel.app;
#   Redirect URLs = https://<your-app>.vercel.app/auth/callback, http://localhost:3001/auth/callback
#
# true = no sign-in (fixed demo user). Flip to false only after Google sign-in works on the production URL.
AUTH_DISABLED=true
# Optional comma list of Google emails allowed in; empty = any Google account.
ALLOWED_EMAILS=

# --- Default models (shown in Settings; the processor uses its own env with the same names) ---------
OPENAI_MODEL=gpt-6.2-sol
ANTHROPIC_MODEL=claude-sonnet-5-5
GEMINI_MODEL=gemini-4-hydrogen
