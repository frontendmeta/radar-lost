# Edge function env for process-run. Copy to supabase/functions/.env (gitignored) for
# `supabase functions serve --env-file supabase/functions/.env`; on hosted, `supabase secrets set` each line.
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically — don't set them here.

# Shared with Next.js (.env.local / Vercel): a long random string.
PROCESSOR_SECRET=
# Optional: the URL process-run re-kicks itself at. Default: $SUPABASE_URL/functions/v1/process-run
PROCESSOR_URL=

# true = deterministic fake shopper (no network) for every assistant; also a fake extractor
# when the extractor's key is missing. Set false once real keys are in.
FAKE_PROVIDERS=false
# Fake-only knobs: max simulated latency (ms) and share of calls that return a retryable 429.
FAKE_LATENCY_MS=2500
FAKE_FAIL_RATE=0

# Shoppers. *_MODEL is the env default; a model set in Settings (assistants.model) wins,
# and each task keeps the model snapshotted at create_run.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6.2-sol
# Responses API reasoning effort for the shopper call (low keeps answers well inside 90 s; empty = model default).
OPENAI_REASONING_EFFORT=low

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Web search server tool version (basic tool, direct calls). Empty = web_search_20250305.
ANTHROPIC_SEARCH_TOOL=
# Optional output_config.effort for the shopper call (low|medium|high). Empty = model default.
ANTHROPIC_EFFORT=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-4-hydrogen

# Extractor and fixes (cheap model; Settings extractor_* / fixes_model override when set).
EXTRACTOR_PROVIDER=anthropic
EXTRACTOR_MODEL=claude-haiku-5-5
FIXES_MODEL=claude-haiku-5-5
